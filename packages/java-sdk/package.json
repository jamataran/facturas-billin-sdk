{
  "name": "@facturas-billin-sdk/java",
  "version": "1.0.0",
  "private": true,
  "description": "Java/Maven SDK for Facturas Billin API",
  "scripts": {
    "generate": "dotenv -e .env.local -- mvn org.openapitools:openapi-generator-maven-plugin:generate -q",
    "build": "dotenv -e .env.local -- mvn clean package -DskipTests -q",
    "test": "dotenv -e .env.local -- mvn test",
    "clean": "mvn clean"
  },
  "devDependencies": {
    "dotenv-cli": "^7.1.0"
  }
}
