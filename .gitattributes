# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.java text
*.php text
*.js text
*.ts text
*.json text
*.xml text
*.yaml text
*.yml text
*.md text

# Scripts
*.sh text eol=lf
*.bat text eol=crlf

# Binary files
*.jar binary
*.zip binary
*.tar binary
*.gz binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
