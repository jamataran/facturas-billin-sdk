{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "dependsOn": ["^generate"],
      "inputs": ["../../openapi-spec/**", "**/openapi-generator-config.yaml"],
      "outputs": ["src/**", "lib/**"]
    },
    "build": {
      "dependsOn": ["generate", "^build"],
      "outputs": ["dist/**", "target/**", "vendor/**"],
      "cache": true
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["**/target/surefire-reports/**", "**/coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
