{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "openapi-spec/**"
  ],
  "tasks": {
    "generate": {
      "inputs": [
        "openapi-generator-config.yaml",
        "openapitools.json",
        "generate.sh"
      ],
      "outputs": [
        "src/**",
        "lib/**",
        "docs/**",
        "api/**",
        ".openapi-generator/**"
      ]
    },
    "build": {
      "dependsOn": ["generate", "^build"],
      "outputs": [
        "dist/**",
        "target/**",
        "vendor/**"
      ],
      "cache": true
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [
        "**/target/surefire-reports/**",
        "**/coverage/**"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
